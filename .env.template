# ═══════════════════════════════════════════════════════════════
# Inevitable - Environment Variables Template
# Copy this to .env and fill in your values
# NEVER commit .env to Git (it's in .gitignore)
# ═══════════════════════════════════════════════════════════════

# ── Trading Mode ──────────────────────────────────────────────────
LIVE_TRADING=false    # Set to "true" for real trading (paper mode if false)

# ── Zerodha Kite API ──────────────────────────────────────────────
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here

# ── Trading Parameters ─────────────────────────────────────────────
DEFAULT_QUANTITY=780         # Units to trade (12 lots × 65 = 780)
TRADING_CAPITAL=96000        # Total capital allocated
SL_POINTS=30                 # Stop loss in points
TRAILING_SL_POINTS=15        # Trailing stop loss
RR_RATIO=2.0                 # Risk:Reward ratio
MAX_ORDERS_PER_DAY=3         # Maximum trades per day

# ── Crude Oil Trading ──────────────────────────────────────────────
CRUDE_LIVE=false             # Enable crude oil trading
CRUDE_CAPITAL=50000          # Capital for crude oil

# ── TrueData (Optional - for 5-year historical data) ───────────────────────
TRUEDATA_USERNAME=           # Leave empty if not using TrueData
TRUEDATA_PASSWORD=

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG, INFO, WARNING, ERROR
